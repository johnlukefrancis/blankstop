{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rust: check",
      "type": "shell",
      "command": "cargo check",
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "build"
    },
    {
      "label": "Rust: build",
      "type": "shell",
      "command": "cargo build",
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "build"
    },
    {
      "label": "Rust: test",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "test"
    },
    {
      "label": "Rust: clippy",
      "type": "shell",
      "command": "cargo clippy",
      "options": {
        "cwd": "${workspaceFolder}/src-tauri"
      },
      "group": "test"
    },
    {
      "label": "Tauri: dev (WSL)",
      "type": "shell",
      "command": "pnpm tauri dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build"
    },
    {
      "label": "Tauri: dev (Windows)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "cd \\\\wsl.localhost\\Ubuntu\\home\\johnf\\code\\blankstop; pnpm tauri dev"
      ],
      "group": "build"
    }
  ]
}
